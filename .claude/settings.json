{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_cloud.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "autoCompactEnabled": true,
  "autoCompactWindow": 150000,
  "precomputeCompactionEnabled": true,
  "bashOutputMaxChars": 12000
}
