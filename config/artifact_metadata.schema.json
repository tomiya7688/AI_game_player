{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-game-player:artifact-metadata:1",
  "title": "AI Game Player Stored Artifact Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sha256", "size_bytes", "media_type", "artifact_type", "sensitive", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "artifact_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "sensitive": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
