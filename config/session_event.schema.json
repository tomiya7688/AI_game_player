{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kadoka.dev/schemas/session-event-v1.schema.json",
  "title": "Kadoka Session Event Envelope",
  "description": "The timestamp pattern asserts a Gregorian UTC date-time ending in Z, including when date-time format is treated only as an annotation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "sequence",
    "timestamp_utc",
    "monotonic_ns",
    "monotonic_epoch_id",
    "event_type",
    "status",
    "frame_id",
    "turn_id",
    "snapshot_id",
    "correlation_id",
    "payload",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "session_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "monotonic_ns": { "type": "integer", "minimum": 0 },
    "monotonic_epoch_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "event_type": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "status": { "type": ["string", "null"], "minLength": 1, "pattern": "\\S" },
    "frame_id": { "type": ["string", "null"], "minLength": 1, "pattern": "\\S" },
    "turn_id": { "type": ["string", "null"], "minLength": 1, "pattern": "\\S" },
    "snapshot_id": { "type": ["string", "null"], "minLength": 1, "pattern": "\\S" },
    "correlation_id": { "type": ["string", "null"], "minLength": 1, "pattern": "\\S" },
    "payload": { "type": "object" },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "sha256", "media_type", "sensitive"],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "media_type": { "type": "string", "pattern": "^[^\\s/]+/[^\\s/]+$" },
          "sensitive": { "type": "boolean" }
        }
      }
    }
  }
}
