{
  "schema": "kadoka-runtime-boundary/v1",
  "contract_version": 1,
  "capabilities": [
    "capture",
    "input",
    "safety",
    "fast_cv"
  ],
  "coarse_boundary_units": [
    "frame",
    "observation",
    "candidate_set",
    "decision",
    "batch",
    "control_lease"
  ],
  "components": [
    {
      "name": "capture",
      "capability": "capture",
      "preferred_language": "cpp",
      "boundary_unit": "frame",
      "status": "partially_native",
      "reason": "Pythonの画面取得に加え、任意のC++ WGC実装がある。frame単位で渡し、利用可否は実行時に確認する。",
      "current_languages": [
        "python",
        "cpp"
      ]
    },
    {
      "name": "input",
      "capability": "input",
      "preferred_language": "cpp",
      "boundary_unit": "decision",
      "status": "native_target",
      "reason": "OS input and release-all are latency/safety sensitive and should not depend on Python scheduling long term.",
      "current_languages": [
        "python"
      ]
    },
    {
      "name": "safety",
      "capability": "safety",
      "preferred_language": "cpp",
      "boundary_unit": "decision",
      "status": "implemented",
      "reason": "意味判断と停止管理はPython、任意のC ABIによる決定論的検証はC++。manifestの宣言だけで独立した停止機構の成立を保証しない。",
      "current_languages": [
        "python",
        "cpp"
      ]
    },
    {
      "name": "fast_cv",
      "capability": "fast_cv",
      "preferred_language": "cpp",
      "boundary_unit": "frame",
      "status": "partially_native",
      "reason": "Pythonの画像処理に加えてC ABIのフレーム前処理primitiveが実装済み。未移行のPython loopだけを実測対象とし、Nativeを使うかはbackend選択と測定で判断する。",
      "current_languages": [
        "python",
        "cpp"
      ]
    },
    {
      "name": "decision_context",
      "preferred_language": "python",
      "boundary_unit": "candidate_set",
      "status": "implemented",
      "reason": "Rapidly changing AI/orchestration logic benefits from Python and is not a per-pixel hot path.",
      "current_languages": [
        "python"
      ]
    },
    {
      "name": "model_orchestration",
      "preferred_language": "python",
      "boundary_unit": "observation",
      "status": "implemented",
      "reason": "AI/ML ecosystem integration and experimentation dominate over interpreter overhead.",
      "current_languages": [
        "python"
      ]
    },
    {
      "name": "evaluation_outcome",
      "preferred_language": "python",
      "boundary_unit": "observation",
      "status": "implemented",
      "reason": "High-level semantic policy remains separate from deterministic native safety.",
      "current_languages": [
        "python"
      ]
    },
    {
      "name": "ui_tooling",
      "preferred_language": "python",
      "boundary_unit": "batch",
      "status": "implemented",
      "reason": "Current Tkinter/Python compatibility UI and developer tools remain implemented. Permanent Qt6 Widgets/C++ GUI and Rust Core are planned separately by target_architecture (#661).",
      "current_languages": [
        "python"
      ]
    },
    {
      "name": "game_rules_plugins",
      "preferred_language": "python",
      "boundary_unit": "candidate_set",
      "status": "lua_deferred",
      "reason": "Lua is a strong embedded rule/plugin candidate, but adding a mandatory script runtime before the plugin contract stabilizes has negative current net benefit.",
      "current_languages": [
        "python"
      ]
    }
  ],
  "languages": {
    "python": {
      "decision": "adopted",
      "roles": [
        "ai_ml",
        "orchestration",
        "evaluation",
        "learning",
        "ui",
        "tooling"
      ]
    },
    "cpp": {
      "decision": "adopted",
      "roles": [
        "native_runtime",
        "safety",
        "input_target",
        "capture_target",
        "fast_cv_target"
      ]
    },
    "lua": {
      "decision": "deferred",
      "roles": [
        "game_specific_rules",
        "policy_plugins"
      ],
      "revisit_when": "A stable plugin ABI exists and measured startup/deployment cost is smaller than the sandboxing and extension benefit."
    },
    "csharp": {
      "decision": "deferred",
      "roles": [
        "windows_shell",
        "native_runtime_management"
      ],
      "revisit_when": "Windows shell, accessibility, installer, tray, or lifecycle requirements materially exceed the current bundled Python UI capability."
    },
    "javascript_typescript": {
      "decision": "optional",
      "roles": [
        "web_control_panel",
        "developer_tooling"
      ],
      "revisit_when": "A browser/web surface is implemented and can remain outside the safety-critical runtime path."
    }
  },
  "distribution": {
    "self_contained": true,
    "manual_end_user_toolchains_forbidden": [
      "python",
      "pip",
      "cmake",
      "msvc",
      "lua",
      "node",
      "dotnet_sdk"
    ],
    "windows_bundle_entrypoint": "tools/build_windows_bundle.ps1",
    "bundled_native_library": "kadoka_native_runtime.dll"
  },
  "target_architecture": {
    "schema": "kadoka-target-architecture/v1",
    "status": "planned",
    "decision_issue": 661,
    "gui": {
      "language": "cpp",
      "framework": "qt6_widgets",
      "embedded_webview": false,
      "issue": 664
    },
    "resident_core": {
      "language": "rust",
      "process": "separate",
      "issue": 665
    },
    "bridge": {
      "control": "versioned_local_ipc",
      "frame": "frame_ref_lease",
      "issue": 666
    },
    "python_worker": {
      "language": "python",
      "required_for_core": false
    },
    "capture": {
      "language": "cpp",
      "status": "existing_compatibility",
      "abi_version": 1
    },
    "safety": {
      "authority": "resident_core",
      "ui_independent": true,
      "stop_bypasses_work_queue": true,
      "issue": 667
    },
    "compatibility": {
      "tkinter": true,
      "python_cpp_abi_v1": true,
      "existing_windows_e2e": true
    },
    "distribution": {
      "status": "unverified",
      "qt_linkage": "dynamic",
      "gpl_only_modules": false,
      "gate_issues": [
        149,
        228,
        663
      ]
    }
  }
}
