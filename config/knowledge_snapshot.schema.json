{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-game-player:knowledge-snapshot:1",
  "title": "Versioned Knowledge Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "version",
    "scope",
    "created_at",
    "expires_at",
    "sample_count",
    "uncertainty",
    "action_outcome_stats",
    "candidate_priors",
    "candidate_reliability",
    "transition_priors",
    "weight_hints",
    "threshold_hints",
    "roi_hints",
    "source_experience_range",
    "update_rule",
    "update_rule_version",
    "builder_state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_id",
        "scene_id",
        "profile_id",
        "player_id",
        "lineage_id"
      ],
      "properties": {
        "game_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        },
        "scene_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        },
        "player_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "action_outcome_stats": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "success",
          "no_effect",
          "failure",
          "unknown",
          "reward_mean",
          "reward_ewma",
          "alpha",
          "beta"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "success": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "no_effect": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "failure": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "unknown": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "reward_mean": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "reward_ewma": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "alpha": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000001
          },
          "beta": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000001
          }
        }
      }
    },
    "candidate_priors": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      }
    },
    "candidate_reliability": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "transition_priors": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_state",
          "action_id",
          "to_state",
          "probability",
          "count"
        ],
        "properties": {
          "from_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
          },
          "to_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          }
        }
      }
    },
    "weight_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "utility": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "recognition": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "knowledge_prior": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "survival": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "resources": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "repetition": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "threshold_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recognition_minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decision_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "roi_hints": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "source_experience_range": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "first_sequence",
          "last_sequence",
          "event_count",
          "sha256"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
          },
          "first_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "last_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "event_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "update_rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
    },
    "update_rule_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
    },
    "builder_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_watermarks",
        "correlation_watermarks"
      ],
      "properties": {
        "source_watermarks": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          }
        },
        "correlation_watermarks": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          }
        }
      }
    }
  }
}
