{
  "schema_version": 1,
  "policy_version": "1.0",
  "classes": [
    {
      "id": "raw_frame",
      "sensitivity": "high",
      "default_persistence": "off",
      "default_retention_ms": 86400000,
      "remote": "opt_in",
      "contains": [],
      "owner_modules": ["ai_game_player.screen_capture", "ai_game_player.shared_frame_producer"],
      "implemented": true,
      "description": "画面取得した未加工のframe画素。1.0では保存しない。"
    },
    {
      "id": "cropped_image",
      "sensitivity": "high",
      "default_persistence": "off",
      "default_retention_ms": 86400000,
      "remote": "opt_in",
      "contains": [],
      "owner_modules": ["ai_game_player.capture_region", "ai_game_player.frame_preprocessor"],
      "implemented": true,
      "description": "frameから切り出した領域画像（ROI/crop）。1.0では保存しない。"
    },
    {
      "id": "ocr_text",
      "sensitivity": "high",
      "default_persistence": "off",
      "default_retention_ms": 604800000,
      "remote": "opt_in",
      "contains": [],
      "owner_modules": ["ai_game_player.ocr_provider", "ai_game_player.ocr_recognizer", "ai_game_player.ocr_detector"],
      "implemented": true,
      "description": "画面から読み取った文字列。画面に表示された個人情報を含み得る。単独では保存しない。"
    },
    {
      "id": "ui_metadata",
      "sensitivity": "medium",
      "default_persistence": "local_bounded",
      "default_retention_ms": 2592000000,
      "remote": "opt_in",
      "contains": [],
      "owner_modules": ["ai_game_player.ui_recognition", "ai_game_player.ui_embedding"],
      "implemented": true,
      "description": "UI要素の種類・座標・特徴量・埋め込みvector。画素や文字列そのものは含まない。"
    },
    {
      "id": "decision_context",
      "sensitivity": "high",
      "default_persistence": "off",
      "default_retention_ms": 604800000,
      "remote": "opt_in",
      "contains": ["ocr_text", "ui_metadata", "history"],
      "owner_modules": ["ai_game_player.decision_context"],
      "implemented": true,
      "description": "判断Providerへ渡す画面要約・候補・評価根拠・直近履歴。OCR抜粋を含む。単独では保存しない。"
    },
    {
      "id": "model_output",
      "sensitivity": "medium",
      "default_persistence": "local_bounded",
      "default_retention_ms": 2592000000,
      "remote": "opt_in",
      "contains": [],
      "owner_modules": ["ai_game_player.provider", "ai_game_player.decision_verifier", "ai_game_player.evaluation_primitives"],
      "implemented": true,
      "description": "Provider・評価器の出力（選択action・理由・評価値）。"
    },
    {
      "id": "history",
      "sensitivity": "medium",
      "default_persistence": "local_bounded",
      "default_retention_ms": 2592000000,
      "remote": "opt_in",
      "contains": [],
      "owner_modules": ["ai_game_player.history", "ai_game_player.execution_history"],
      "implemented": true,
      "description": "実行したactionと結果の履歴。"
    },
    {
      "id": "trace",
      "sensitivity": "high",
      "default_persistence": "local_bounded",
      "default_retention_ms": 2592000000,
      "remote": "opt_in",
      "contains": ["decision_context", "model_output"],
      "owner_modules": [
        "ai_game_player.decision_context",
        "ai_game_player.event_journal",
        "ai_game_player.runtime_mode_recorder",
        "ai_game_player.campaign_artifacts",
        "ai_game_player.campaign_execution",
        "ai_game_player.e2e_runner"
      ],
      "implemented": true,
      "description": "判断trace・Session event journal・campaign/E2E event。判断材料とProvider出力を含むためlocal-onlyかつ期限付き。"
    },
    {
      "id": "video",
      "sensitivity": "high",
      "default_persistence": "off",
      "default_retention_ms": 604800000,
      "remote": "never",
      "contains": ["raw_frame"],
      "owner_modules": [],
      "implemented": false,
      "description": "Session録画（#201）。未実装。1.0では録画しない。"
    },
    {
      "id": "replay",
      "sensitivity": "high",
      "default_persistence": "off",
      "default_retention_ms": 604800000,
      "remote": "never",
      "contains": ["raw_frame", "trace"],
      "owner_modules": [],
      "implemented": false,
      "description": "frameとtraceを再生可能な形で束ねたreplay。未実装。1.0では保存しない。"
    },
    {
      "id": "learning_dataset",
      "sensitivity": "high",
      "default_persistence": "off",
      "default_retention_ms": 2592000000,
      "remote": "never",
      "contains": ["decision_context", "model_output"],
      "owner_modules": ["ai_game_player.learning_dataset"],
      "implemented": true,
      "description": "学習用に抽出したsample集合。明示操作でだけ生成する。"
    },
    {
      "id": "challenger_artifact",
      "sensitivity": "medium",
      "default_persistence": "local_bounded",
      "default_retention_ms": 2592000000,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.challenger_update", "ai_game_player.knowledge_promotion"],
      "implemented": true,
      "description": "昇格前の更新候補（model delta・部品parameterのChallenger等）と、その評価・検証report。"
    },
    {
      "id": "knowledge",
      "sensitivity": "medium",
      "default_persistence": "local",
      "default_retention_ms": null,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.knowledge", "ai_game_player.knowledge_snapshot_store", "ai_game_player.light_pending_store"],
      "implemented": true,
      "description": "ゲーム別に蓄積した知識と、採用済みKnowledge snapshot。利用者が削除するまで保持する。"
    },
    {
      "id": "crash_diagnostic",
      "sensitivity": "medium",
      "default_persistence": "local_bounded",
      "default_retention_ms": 1209600000,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.planning_worker_diagnostic", "ai_game_player.bundle_self_check"],
      "implemented": true,
      "description": "worker異常終了の診断・配布物self-check report。外部提出は利用者の明示操作だけ。"
    },
    {
      "id": "safety_audit",
      "sensitivity": "medium",
      "default_persistence": "local_bounded",
      "default_retention_ms": 2592000000,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.action_safety", "ai_game_player.safety_guard", "ai_game_player.fail_safe_runtime"],
      "implemented": true,
      "description": "Safety判定・入力ledger・fail-safe journal。"
    },
    {
      "id": "runtime_log",
      "sensitivity": "medium",
      "default_persistence": "local_bounded",
      "default_retention_ms": 1209600000,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.runtime_log"],
      "implemented": true,
      "description": "通常の実行log。credentialを書かない。"
    },
    {
      "id": "app_config",
      "sensitivity": "low",
      "default_persistence": "local",
      "default_retention_ms": null,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.config", "ai_game_player.ui.shell"],
      "implemented": true,
      "description": "利用者の設定とUI状態。credentialを含めない。"
    },
    {
      "id": "quality_report",
      "sensitivity": "low",
      "default_persistence": "local",
      "default_retention_ms": null,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.applications.quality.data.report_processing"],
      "implemented": true,
      "description": "開発用のbug/performance検査report。利用者の画面dataを含まない。"
    },
    {
      "id": "worker_ipc",
      "sensitivity": "low",
      "default_persistence": "transient",
      "default_retention_ms": null,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.planning_file_publisher", "ai_game_player.bounded_planner", "ai_game_player.planning_worker"],
      "implemented": true,
      "description": "planning workerとの一時file IPC（request/ready/checkpoint/finished）。実行後に一時directoryごと消える。"
    },
    {
      "id": "unclassified",
      "sensitivity": "high",
      "default_persistence": "off",
      "default_retention_ms": 86400000,
      "remote": "never",
      "contains": [],
      "owner_modules": ["ai_game_player.artifact_store"],
      "implemented": true,
      "description": "意味型を宣言しない汎用payload（binary.payload）。最も厳しい扱いにする。"
    },
    {
      "id": "credential",
      "sensitivity": "forbidden",
      "default_persistence": "never",
      "default_retention_ms": null,
      "remote": "never",
      "contains": [],
      "owner_modules": [],
      "implemented": false,
      "description": "password・API key・token・cookie等。通常のdata flow・保存・送信のいずれにも含めない。"
    }
  ],
  "artifact_types": {
    "binary.payload": "unclassified",
    "frame.raw": "raw_frame",
    "frame.crop": "cropped_image",
    "video.segment": "video",
    "knowledge.snapshot": "knowledge",
    "knowledge.evaluation": "challenger_artifact",
    "knowledge.light_validation": "challenger_artifact",
    "learning.challenger": "challenger_artifact",
    "model.delta": "challenger_artifact",
    "model.adapter": "challenger_artifact",
    "ocr.model_delta": "challenger_artifact"
  },
  "writers": [
    {"site": "ai_game_player.action_safety:ActionSafetyAuditLog", "data_class": "safety_audit", "paths": ["action_safety.json"]},
    {"site": "ai_game_player.applications.quality.data.report_processing:save_json_report", "data_class": "quality_report", "paths": []},
    {"site": "ai_game_player.admission_pending_store:PendingAdmissionStore", "data_class": null, "paths": [], "note": "中断したadmissionの回収用record。digest・entry_id・size・source_ref・pidだけを持ち、payloadは持たない。"},
    {"site": "ai_game_player.artifact_store:FileSystemArtifactStore", "data_class": null, "paths": ["payload", "metadata.json"], "note": "content-addressed store。classはartifact_typesで決まる。"},
    {"site": "ai_game_player.atomic_json:stage_json_write", "data_class": null, "paths": [], "note": "原子的JSON書込みの基盤。classは呼出側のwriterで決まる。"},
    {"site": "ai_game_player.atomic_json:write_json_array_atomically", "data_class": null, "paths": [], "note": "原子的JSON書込みの基盤。classは呼出側のwriterで決まる。"},
    {"site": "ai_game_player.bundle_self_check:run_bundle_self_check", "data_class": "crash_diagnostic", "paths": []},
    {"site": "ai_game_player.campaign_artifacts:append_campaign_event", "data_class": "trace", "paths": []},
    {"site": "ai_game_player.campaign_execution:CampaignRunner", "data_class": "trace", "paths": []},
    {"site": "ai_game_player.config:ConfigStore", "data_class": "app_config", "paths": ["data/config.json"]},
    {"site": "ai_game_player.cross_process_lock:cross_process_file_lock", "data_class": null, "paths": [], "note": "process間lock file。dataを書かない。"},
    {"site": "ai_game_player.decision_context:DecisionTraceStore", "data_class": "trace", "paths": ["decision_trace.json"]},
    {"site": "ai_game_player.e2e_runner:append_e2e_event", "data_class": "trace", "paths": []},
    {"site": "ai_game_player.evaluation_primitives:EvaluationLog", "data_class": "model_output", "paths": []},
    {"site": "ai_game_player.event_journal:EventJournal", "data_class": "trace", "paths": ["session_events", ".sqlite3"]},
    {"site": "ai_game_player.execution_history:ExecutionHistory", "data_class": "history", "paths": ["execution_history.json"]},
    {"site": "ai_game_player.fail_safe_runtime:AtomicJsonStore", "data_class": "safety_audit", "paths": ["fail_safe", "journal.json", "lease.json", "input_ledger.json", ".kadoka-fail-safe"]},
    {"site": "ai_game_player.history:HistoryStore", "data_class": "history", "paths": ["history.json"]},
    {"site": "ai_game_player.knowledge:KnowledgeStore", "data_class": "knowledge", "paths": ["knowledge.json"]},
    {"site": "ai_game_player.knowledge_promotion:KnowledgePromotionGate", "data_class": "challenger_artifact", "paths": ["reports", "state.json"]},
    {"site": "ai_game_player.knowledge_snapshot_store:KnowledgeSnapshotStore", "data_class": "knowledge", "paths": ["objects", "snapshots", "light_adaptation", "publication"]},
    {"site": "ai_game_player.light_pending_store:write_pending_deltas", "data_class": "knowledge", "paths": ["pending"]},
    {"site": "ai_game_player.planning_file_publisher:publish_planning_bytes", "data_class": "worker_ipc", "paths": ["request.json", "ready.json", "checkpoint.json", "finished.json"]},
    {"site": "ai_game_player.planning_worker_diagnostic:WorkerDiagnostic", "data_class": "crash_diagnostic", "paths": ["python_failure.json"]},
    {"site": "ai_game_player.retention_collector:LocalRetentionFileSystem", "data_class": null, "paths": ["retention-index.json"], "note": "Retention索引。digest・size・時刻だけを持つ。"},
    {"site": "ai_game_player.runtime.session_composition:RuntimeComposition", "data_class": null, "paths": ["legacy_migration_v1.pending", "legacy_migration_v1.complete"], "note": "journal移行のmarker。journal名と移行元pathだけを持つ。"},
    {"site": "ai_game_player.runtime.session_composition:_legacy_migration_lock", "data_class": null, "paths": [], "note": "移行用lock file。dataを書かない。"},
    {"site": "ai_game_player.runtime_log:RuntimeLog", "data_class": "runtime_log", "paths": ["user_data/output/log/ai_game_player.jsonl"]},
    {"site": "ai_game_player.runtime_mode_recorder:RuntimeModeRecorder", "data_class": "trace", "paths": []},
    {"site": "ai_game_player.safety_guard:SafetyLog", "data_class": "safety_audit", "paths": ["safety_guard.jsonl"]},
    {"site": "ai_game_player.ui.shell:ShellStateStore", "data_class": "app_config", "paths": ["data/shell_state.json"]},
    {"site": "ai_game_player.ui_embedding:EmbeddingCache", "data_class": "ui_metadata", "paths": []},
    {"site": "ai_game_player.ui_embedding:EmbeddingMemory", "data_class": "ui_metadata", "paths": []},
    {"site": "ai_game_player.ui_recognition:UiRecognitionMemory", "data_class": "ui_metadata", "paths": []}
  ],
  "transmitters": [
    {"site": "ai_game_player.provider:OllamaProvider.list_models", "data_classes": [], "note": "model一覧取得（GET）。利用者dataを送らない。"},
    {"site": "ai_game_player.provider:OllamaProvider.assess_outcome", "data_classes": ["ocr_text", "ui_metadata"], "note": "ScreenObservation.to_dict()（OCR全文・features）を設定endpointへ送る。"},
    {"site": "ai_game_player.provider:OllamaProvider._request_decision", "data_classes": ["decision_context", "ocr_text", "ui_metadata", "history"], "note": "choose_context()はDecision Context、旧choose()はScreenObservationと候補を設定endpointへ送る。"}
  ],
  "non_data_paths": {
    "assets": "同梱の読取専用asset",
    "players": "同梱の読取専用asset",
    "wise_misk": "同梱の読取専用asset",
    "pack.json": "同梱の読取専用asset",
    "privacy": "同梱の読取専用asset（本inventory）",
    "data_inventory.json": "同梱の読取専用asset（本inventory）",
    "data/games/sandbox": "game directoryの既定root。中のfileは各writerで分類する",
    "state.lock": "lock file。dataを書かない",
    ".checkpoint.json": "Experience readerが読むだけのcheckpoint名",
    "runtime.log": "event kind名。file pathではない"
  },
  "forbidden_field_names": [
    "access_token",
    "api_key",
    "apikey",
    "authorization",
    "client_secret",
    "cookie",
    "credential",
    "credentials",
    "passwd",
    "password",
    "private_key",
    "refresh_token",
    "secret",
    "session_token",
    "token"
  ]
}
