{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kadoka.dev/schema/inference-provider/v1/inference-request.schema.json",
  "title": "Kadoka Inference Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "operation",
    "model",
    "context",
    "input",
    "constraints",
    "sampling",
    "privacy"
  ],
  "properties": {
    "schema": { "const": "kadoka.inference.request/1" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": {
      "enum": ["decision", "outcome_assessment", "text_generation"]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "session_id": { "type": ["string", "null"], "maxLength": 128 },
        "turn_id": { "type": ["string", "integer", "null"] },
        "frame_id": { "type": ["string", "integer", "null"] },
        "created_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        },
        "decision_context": {
          "type": "object",
          "additionalProperties": true
        },
        "allowed_action_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "outcome_context": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_ms", "max_output_tokens", "response_format"],
      "properties": {
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "response_format": {
          "$ref": "#/$defs/responseFormat"
        },
        "stop": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "top_k": { "type": ["integer", "null"], "minimum": 1 },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_transmission_allowed",
        "data_classes",
        "sensitive_data_present"
      ],
      "properties": {
        "remote_transmission_allowed": { "type": "boolean" },
        "data_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "decision_context",
              "ocr_text",
              "cropped_image",
              "raw_frame",
              "history",
              "trace"
            ]
          }
        },
        "sensitive_data_present": { "type": "boolean" },
        "policy_ref": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "decision" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "input": {
            "required": ["decision_context", "allowed_action_ids"]
          },
          "constraints": {
            "properties": {
              "response_format": {
                "properties": {
                  "type": { "const": "candidate_selection" }
                },
                "required": ["type"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "outcome_assessment" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "input": { "required": ["outcome_context"] }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "text_generation" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "input": { "required": ["messages"] }
        }
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "developer", "user", "assistant"] },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "text"],
                "properties": {
                  "type": { "const": "text" },
                  "text": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": { "const": "json" },
                  "value": {}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "mime_type", "sha256"],
                "properties": {
                  "type": { "const": "image" },
                  "mime_type": {
                    "enum": ["image/png", "image/jpeg", "image/webp"]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "artifact_ref": { "type": ["string", "null"], "maxLength": 1024 },
                  "data_base64": { "type": ["string", "null"], "contentEncoding": "base64" }
                },
                "oneOf": [
                  { "required": ["artifact_ref"] },
                  { "required": ["data_base64"] }
                ]
              }
            ]
          }
        }
      }
    },
    "responseFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["candidate_selection", "text", "json_object", "json_schema"]
        },
        "json_schema": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "json_schema" } },
            "required": ["type"]
          },
          "then": { "required": ["json_schema"] }
        }
      ]
    }
  }
}
