{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kadoka.dev/schema/inference-provider/v1/provider-manifest.schema.json",
  "title": "Kadoka Inference Provider Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider_id",
    "provider_version",
    "protocol_versions",
    "display_name",
    "deployment",
    "capabilities",
    "privacy"
  ],
  "properties": {
    "schema": { "const": "kadoka.inference.provider-manifest/1" },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "provider_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "base_url", "health_path", "capabilities_path", "models_path", "inference_path"],
      "properties": {
        "kind": {
          "enum": ["bundled_local", "local_external", "remote_adapter"]
        },
        "base_url": { "type": "string", "format": "uri" },
        "health_path": { "type": "string", "pattern": "^/" },
        "capabilities_path": { "type": "string", "pattern": "^/" },
        "models_path": { "type": "string", "pattern": "^/" },
        "inference_path": { "type": "string", "pattern": "^/" },
        "cancel_path": {
          "type": ["string", "null"],
          "pattern": "^/"
        },
        "default_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "input_modalities",
        "structured_output",
        "streaming",
        "cancellation"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["decision", "outcome_assessment", "text_generation"]
          }
        },
        "input_modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["text", "json", "image"] }
        },
        "structured_output": { "type": "boolean" },
        "streaming": { "const": false },
        "cancellation": { "type": "boolean" },
        "max_concurrency": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_transmit_off_device", "credentials_required"],
      "properties": {
        "may_transmit_off_device": { "type": "boolean" },
        "credentials_required": { "type": "boolean" },
        "declared_data_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "decision_context",
              "ocr_text",
              "cropped_image",
              "raw_frame",
              "history",
              "trace"
            ]
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": { "cancellation": { "const": true } },
            "required": ["cancellation"]
          }
        }
      },
      "then": {
        "properties": {
          "deployment": {
            "required": ["cancel_path"],
            "properties": {
              "cancel_path": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "properties": { "kind": { "const": "remote_adapter" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "deployment": {
            "properties": {
              "base_url": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          },
          "privacy": {
            "properties": {
              "may_transmit_off_device": { "const": true }
            }
          }
        }
      }
    }
  ]
}
