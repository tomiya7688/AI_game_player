{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kadoka.dev/schema/inference-provider/v1/capabilities-response.schema.json",
  "title": "Kadoka Inference Capabilities Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider_id",
    "provider_version",
    "protocol_version",
    "operations",
    "input_modalities",
    "response_formats",
    "streaming",
    "cancellation"
  ],
  "properties": {
    "schema": { "const": "kadoka.inference.capabilities/1" },
    "provider_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "provider_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "protocol_version": { "const": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["decision", "outcome_assessment", "text_generation"] }
    },
    "input_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["text", "json", "image"] }
    },
    "response_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["candidate_selection", "text", "json_object", "json_schema"] }
    },
    "streaming": { "const": false },
    "cancellation": { "type": "boolean" },
    "max_concurrency": { "type": ["integer", "null"], "minimum": 1 },
    "max_context_tokens": { "type": ["integer", "null"], "minimum": 1 },
    "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
