{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kadoka.dev/schema/inference-provider/v1/inference-response.schema.json",
  "title": "Kadoka Inference Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "status", "operation", "timing"],
  "properties": {
    "schema": { "const": "kadoka.inference.response/1" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["success", "error", "cancelled", "timeout"] },
    "operation": {
      "enum": ["decision", "outcome_assessment", "text_generation"]
    },
    "provider": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_version",
        "protocol_version",
        "model_id"
      ],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "provider_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocol_version": { "const": 1 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_revision": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "result": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unsupported_protocol",
            "unsupported_operation",
            "model_unavailable",
            "schema_violation",
            "deadline_exceeded",
            "rate_limited",
            "auth_failed",
            "provider_unavailable",
            "provider_error",
            "cancelled"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "details": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_ms"],
      "properties": {
        "queue_ms": { "type": ["number", "null"], "minimum": 0 },
        "inference_ms": { "type": ["number", "null"], "minimum": 0 },
        "total_ms": { "type": "number", "minimum": 0 }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "success" } },
        "required": ["status"]
      },
      "then": {
        "required": ["provider", "result"],
        "properties": {
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["error", "cancelled", "timeout"] } },
        "required": ["status"]
      },
      "then": {
        "required": ["error"],
        "properties": {
          "result": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "success" },
          "operation": { "const": "decision" }
        },
        "required": ["status", "operation"]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selected_action_id"],
            "properties": {
              "selected_action_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "confidence": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": ["string", "null"],
                "maxLength": 8192
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "success" },
          "operation": { "const": "outcome_assessment" }
        },
        "required": ["status", "operation"]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "confidence"],
            "properties": {
              "outcome": {
                "enum": ["success", "failure", "ongoing", "unknown"]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": "array",
                "items": { "type": "string", "maxLength": 2048 }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "success" },
          "operation": { "const": "text_generation" }
        },
        "required": ["status", "operation"]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "json": {}
            }
          }
        }
      }
    }
  ]
}
