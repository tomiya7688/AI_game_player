{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kadoka.dev/schema/inference-provider/v1/health-response.schema.json",
  "title": "Kadoka Inference Health Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider_id", "provider_version", "status", "protocol_versions"],
  "properties": {
    "schema": { "const": "kadoka.inference.health/1" },
    "provider_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "provider_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "status": { "enum": ["healthy", "degraded", "unavailable"] },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "uptime_ms": { "type": ["integer", "null"], "minimum": 0 },
    "active_requests": { "type": ["integer", "null"], "minimum": 0 },
    "message": { "type": ["string", "null"], "maxLength": 2048 },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
