{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kadoka.dev/schema/config/e2e-reference-games.schema.json",
  "title": "Kadoka E2E Reference Game Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "materialization", "levels"],
  "properties": {
    "schema": { "const": "kadoka.reference-games/1" },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "destination",
        "commit_upstream_latest",
        "record_lock_metadata"
      ],
      "properties": {
        "strategy": { "const": "pinned_git_checkout" },
        "destination": { "type": "string", "minLength": 1 },
        "commit_upstream_latest": { "const": false },
        "record_lock_metadata": { "const": true }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/game" },
      "allOf": [
        { "contains": { "properties": { "level": { "const": 1 } }, "required": ["level"] }, "minContains": 1 },
        { "contains": { "properties": { "level": { "const": 2 } }, "required": ["level"] }, "minContains": 1 },
        { "contains": { "properties": { "level": { "const": 3 } }, "required": ["level"] }, "minContains": 1 },
        { "contains": { "properties": { "level": { "const": 4 } }, "required": ["level"] }, "minContains": 1 }
      ]
    }
  },
  "$defs": {
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "id",
        "title",
        "repository",
        "commit",
        "license_spdx",
        "license_paths",
        "launch",
        "controls",
        "focus",
        "ci_status"
      ],
      "properties": {
        "level": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
        "title": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "license_spdx": { "type": "string", "minLength": 1 },
        "license_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "additional_license_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entrypoint"],
          "properties": {
            "kind": {
              "enum": ["browser_static", "web_or_native_build", "python_pygame"]
            },
            "entrypoint": { "type": "string", "minLength": 1 },
            "requirements": { "type": "string", "minLength": 1 },
            "build_required_may_vary": { "type": "boolean" }
          }
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "focus": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "ci_status": { "enum": ["source_pinned", "level1_target", "active_gate"] },
        "issue": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
